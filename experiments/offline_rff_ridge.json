{
  "name": "offline_rff_ridge",
  "description": "Offline features, RBF kernel ridge via 600 random Fourier features; gamma and alpha chosen by grouped CV.",
  "datasets": [
    "FD001",
    "FD002",
    "FD003",
    "FD004"
  ],
  "cv_folds": 5,
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "rul_cap": 125,
  "features": {
    "set": "offline",
    "regimes": "auto",
    "window": 30,
    "rolling": [
      "mean",
      "slope",
      "std"
    ]
  },
  "model": {
    "type": "rff_ridge",
    "grid": {
      "gamma_scale": [
        0.125,
        0.25,
        0.5,
        1
      ],
      "alpha": [
        0.03,
        0.3,
        3,
        30
      ]
    }
  }
}
